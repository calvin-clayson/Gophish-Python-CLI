#Creates a function to create a sending profile in Gophish
def create_sending_profile():
    try:
        SMTPprofilename = input("Enter a name for the sending profile: ")
        #Defaults the interface type to SMTP for sending profiles
        interfacetype = "SMTP"
        fromaddress = input("Enter the 'From' email address (e.g., sender@example.com): ")
        hostandport = input("Enter the SMTP server host and port (e.g., smtp.example.com:587): ")
        SMTPusername = input("Enter the SMTP username: ")
        SMTPpassword = input("Enter the SMTP password: ")
        cprint("Note: If your SMTP server uses a self-signed certificate, you may want to ignore certification errors. This is not recommended for production environments.", "yellow")
        while True:
            smtpcertification = input("Do you want to ignore SMTP certification errors? (yes/no): ").strip().lower()
            if smtpcertification == 'yes':
                smtpignorecertificationerrors = True
                break
            elif smtpcertification == 'no':
                smtpignorecertificationerrors = False
                break
            else:
                cprint("Invalid input. Please enter 'yes' or 'no'.", "red")

        sendingprofile = SMTP(name=SMTPprofilename, interface_type=interfacetype, from_address=fromaddress, host=hostandport, username=SMTPusername, password=SMTPpassword, ignore_cert_errors=smtpignorecertificationerrors)
        created_sendingprofile = API.smtp.post(sendingprofile)
        print(f"Created sending profile: id={created_sendingprofile.id} name={created_sendingprofile.name}")
    
    except Exception as sending_profile_creation_error:
        print(f"An error occurred while creating the sending profile: {sending_profile_creation_error}")

