#Creates a function to import targets from a CSV file
#csv_filepath parameter in the function can be hardcoded
def import_targets_from_csv(csv_filepath=None):
    global targets
    targets = []

    try:
        #If csv_filepath is not provided as an argument, it prompts the user to enter the path to the CSV file with targets, or allows them to skip if they do not have one
        if csv_filepath is None:
            csv_filepath = input("Enter the path to the CSV file with targets: ").strip()

        while True:
            #If the file path is valid, it breaks the loop and continues with importing targets from the CSV file
            if os.path.isfile(csv_filepath):
                break
            #If the user inputs 'exit', it breaks the loop and exits the CSV target import
            if csv_filepath.lower() == 'exit':
                break
            #If the file path is invalid, it prompts the user to enter a valid file path or type 'exit' to quit the CSV target import
            cprint("File not found. Please enter a valid file path. Type 'exit' to quit.", "red")
            #Asks user for the path to the CSV file with targets again if the previous input was invalid
            csv_filepath = input("Enter the path to the CSV file with targets: ").strip()

        try:
            targets = []
            # Open the CSV and validate header and rows for consistency
            with open(csv_filepath, newline='') as csvfile:
                reader = csv.reader(csvfile)
                header = next(reader, None)
                if not header:
                    cprint("CSV file is empty. No targets imported.", "red")
                    return []

                # Normalize header names
                header_norm = [h.strip().lower() for h in header]
                col_count = len(header_norm)

                # Helper to find a header index from alternatives
                def find_idx(alts):
                    for a in alts:
                        if a in header_norm:
                            return header_norm.index(a)
                    return None

                # Find indices for required columns with common variations in naming
                first_index = find_idx(["firstname", "first_name"])
                last_index = find_idx(["lastname", "last_name"])
                email_index = find_idx(["email", "email_address"])
                pos_index = find_idx(["position", "job_title"])

                #Fails if required columns are missing
                if first_index is None or last_index is None or email_index is None:
                    cprint("CSV missing required columns: firstname, lastname, email.", "red")
                    return []

                #Increments through rows in the CSV file and creates User objects for each valid row, while handling rows with missing or extra columns and skipping rows missing required fields
                line_num = 1  # header line
                for row in reader:
                    line_num += 1
                    # Handle rows with missing trailing columns by padding them
                    if len(row) < col_count:
                        row = row + [""] * (col_count - len(row))
                    # If a row has more columns than the header, warn and skip
                    elif len(row) > col_count:
                        cprint(f"Row {line_num} has {len(row)} columns; expected {col_count}.", "red")
                        continue

                    firstname = row[first_index].strip()
                    lastname = row[last_index].strip()
                    email = row[email_index].strip()
                    #Checks to ensure email contains an "@" symbol as a basic validation of email format, and skips rows with invalid email formats
                    if "@" not in email:
                        cprint(f"Row {line_num} has invalid email format: '{email}'. Skipping.", "red")
                        continue
                    #Handles optional position column, allowing it to be missing or empty without failing the import of the row
                    position = None
                    if pos_index is not None:
                        pos_val = row[pos_index].strip()
                        position = pos_val if pos_val != "" else None

                    # Skip rows missing required values but continue importing others
                    if not firstname or not lastname or not email:
                        cprint(f"Row {line_num} missing required fields; skipping.", "red")
                        continue

                    user = User(first_name=firstname, last_name=lastname, email=email, position=position)
                    targets.append(user)

                print(f"Imported {len(targets)} targets from {csv_filepath}.")
            return targets
        except Exception as csv_error:
            cprint(f"Exiting CSV target import: {csv_error}", "yellow")
    
    except Exception as file_error:
        cprint(f"An error occurred while accessing the file: {file_error}", "red")
        return []

#Creates a function to create an email template in Gophish
def create_email_template():
    try:
        #Gathers user input for the emailtemplate variable that will be created
        nameoftemplate = input("Enter a name for the email template: ").strip()
        emailsubject = input("Enter the subject line for the email: ").strip()
        textemailbody = input("Enter the text body of the email: ").strip()
        htmlemailbody = input("Enter the HTML body of the email: ").strip()
        attachments = []
        
        while True:
            cprint("Note: File attachments may only be added when creating a new email template. Modifying an existing template to add attachments causes issues with how Gophish handles names.", "yellow")
            addfileattachment = input("Do you want to add a file attachment to the email template? (yes/no): ").strip().lower()
            if addfileattachment == 'yes':
                file_path = input("Enter the path to the file to attach (or type '0' to cancel adding attachments): ").strip()
                if file_path.lower() == '0' or file_path == '':
                    break
                if not os.path.isfile(file_path):
                    cprint("File not found. Please enter a valid file path.", "red")
                    continue
                try:
                    with open(file_path, 'rb') as f:
                        data = f.read()
                    encoded = base64.b64encode(data).decode('utf-8')
                    attachments.append({
                        "name": os.path.basename(file_path),
                        "content": encoded
                    })
                    cprint(f"Attached file: {os.path.basename(file_path)}", "green")
                except Exception as file_attachment_error:
                    cprint(f"Error reading file: {file_attachment_error}", "red")
                    continue
            elif addfileattachment == 'no':
                break
            else:
                cprint("Invalid input. Please enter 'yes' or 'no'.", "red")

        payload = {
            "name": nameoftemplate,
            "subject": emailsubject,
            "html": htmlemailbody,
            "text": textemailbody
        }

        if attachments:
            payload["attachments"] = attachments
        try:
            endpoint = "api/templates/"
            resp = API.templates.api.execute("POST", endpoint, json=payload)
            if not resp.ok:
                cprint(f"Failed to create template: {resp.status_code} {resp.text}", "red")
                return
            created_template = API.templates._cls.parse(resp.json())
            cprint(f"Created email template: id={created_template.id} name={created_template.name}", "red")
        except Exception as template_error:
            cprint(f"Error creating template: {template_error}", "red")
    
    except Exception as template_creation_error:
        cprint(f"An error occurred while creating the email template: {template_creation_error}", "red")

