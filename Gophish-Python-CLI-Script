#Not Finished or Tested all the way
def normalize_api_url(value: str) -> str:
    if not value:
        return "https://127.0.0.1:3333/"
    v = value.strip()
    if v.startswith("http://") or v.startswith("https://"):
        return v if v.endswith("/") else v + "/"
    if ":" in v:
        url = f"https://{v}"
        return url if url.endswith("/") else url + "/"
    return f"https://{v}:3333/"

def run_script(args):
    if args.skip_setup:
        dotenv_api_key_setup()
        return
    api_url = normalize_api_url(getattr(args, 'api_url', None))
    dotenv_setup_question()
    dotenv_api_key_setup()
    api_connection_check(api_url)


