def modify_group():
    modify_groups = API.groups.get()
    if not modify_groups:
        print("No groups available to modify.")
        return
    cprint("Groups:", "white")
    for listnumber, groupobject in enumerate(modify_groups, start=1):
        cprint(f"{listnumber}. Group ID= {groupobject.id} Group Name= {groupobject.name}", "red")
    while True:
        groupchoice = input("Enter list number of the group to modify (or 0 to cancel): ").strip()
        if groupchoice == "0":
            print("Cancelled group modification.")
            return
        
        try:
            groupnumberchoice = int(groupchoice)
        except ValueError:
            print("Please type a list number.")
            continue
        
        if 1 <= groupnumberchoice <= len(modify_groups):
            chosen_group = modify_groups[groupnumberchoice-1]
            break
        print("No group matched that list number. Try again.")

    try:
        while True:
            modification_choice = input("Enter 'name' to modify group name, 'targets' to modify group targets, or '0' to finish: ").strip().lower()
            if modification_choice == "0":
                break
            elif modification_choice == "name":
                new_name = input("Enter the new name for the group: ").strip()
                chosen_group.name = new_name
                try:
                    API.groups.put(chosen_group)
                    cprint(f"Group name updated to: {chosen_group.name}", "green")
                except Exception as update_error:
                    cprint(f"An error occurred while updating the group name: {update_error}", "red")
            elif modification_choice == "targets":
                print("Current targets in the group:")
                # Support target entries that may be returned as dicts or model objects
                def get_field(target_field, field_name):
                    if isinstance(target_field, dict):
                        return target_field.get(field_name)
                    return getattr(target_field, field_name, None)

                for target in chosen_group.targets:
                    first = get_field(target, 'first_name')
                    last = get_field(target, 'last_name')
                    email = get_field(target, 'email')
                    cprint(f"{first} {last} - {email}", "white")
                target_action = input("Enter 'add' to add targets, 'remove' to remove targets, or '0' to return: ").strip().lower()
                if target_action == "add":
                    new_targets_input = input("Enter new targets to add (format: first_name last_name email), separated by a space: ").strip()
                    new_targets_list = new_targets_input.split(";")
                    for target_str in new_targets_list:
                        try:
                            first_name, last_name, email = target_str.strip().split()
                            # Append a plain dict to avoid mixing object types from the API
                            new_target = { 'first_name': first_name, 'last_name': last_name, 'email': email }
                            chosen_group.targets.append(new_target)
                            try:
                                API.groups.put(chosen_group)
                                cprint(f"Added target: {first_name} - {last_name} - {email}", "green")
                            except Exception as update_error:
                                cprint(f"An error occurred while updating the group targets: {update_error}", "red")
                                # If update failed, remove the appended target to keep local state consistent
                                chosen_group.targets = [failed_target for failed_target in chosen_group.targets if get_field(failed_target, 'email') != email]
                        except ValueError:
                            cprint(f"Invalid target format: '{target_str}'. Skipping.", "red")
                elif target_action == "remove":
                    remove_email = input("Enter the email of the target to remove: ").strip()
                    original_count = len(chosen_group.targets)
                    new_targets = [target_email for target_email in chosen_group.targets if get_field(target_email, 'email') != remove_email]
                    if len(new_targets) == original_count:
                        cprint(f"No target with email '{remove_email}' found in the group.", "red")
                        continue
                    chosen_group.targets = new_targets
                    try:
                        API.groups.put(chosen_group)
                        cprint(f"Target with email '{remove_email}' removed from group.", "green")
                    except Exception as update_error:
                        cprint(f"An error occurred while updating the group targets: {update_error}", "red")
                elif target_action == "0":
                    break
                else:
                    cprint("Invalid action. Please enter 'add', 'remove', or '0'.", "red")
            else:
                cprint("Invalid modification choice. Please enter 'name', 'targets', or '0'.", "red")
    except Exception as modify_error:
        print(f"An error occurred while modifying the group: {modify_error}")

