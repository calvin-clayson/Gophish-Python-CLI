#Asks user for the path to the .env file with the GoPhish API key and attempts to load it, handling errors if the file is not found or if the API key is not found in the file
#User can enter a preloaded file path to skip some sections
def dotenv_api_key_setup():
    global Preloaded_Dotenv_API_Key_Path
    global API
